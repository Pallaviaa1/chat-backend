PORT=3000
LOG_LEVEL=info
AUTO_MIGRATE=true

# MySQL. Matches docker-compose.yml.
DATABASE_URL=mysql://chat:chat@localhost:3306/chat

# Firestore.
# Local emulator (recommended for this assignment):
#   npm run emulators
#   then keep the two lines below and leave the service account blank.
FIREBASE_PROJECT_ID=demo-chat
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Production / real Firebase project. Leave blank when the emulator host is set.
# The emulator is preferred whenever FIRESTORE_EMULATOR_HOST is present, so a
# local run cannot accidentally write to a live project.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
